---
import { render } from "astro:content";
import Article from "../../layouts/Article.astro";
import PostScripts from "../../components/PostScripts.astro";
import { getWriting, type Post } from "../../lib/collections";

export async function getStaticPaths() {
  const listed = await getWriting();
  const posts = await getWriting({ includeUnlisted: true });
  return posts.map((post) => {
    const i = listed.findIndex((p) => p.id === post.id);
    return {
      params: { slug: post.data.slug },
      props: { post, prev: i < 0 ? undefined : listed[i + 1], next: i < 0 ? undefined : listed[i - 1] },
    };
  });
}

interface Props { post: Post; prev?: Post; next?: Post }
const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const link = (p?: Post) => (p ? { url: p.url, title: p.data.title } : undefined);
---
<Article
  title={post.data.title}
  kind={post.data.kind}
  date={post.date}
  tags={post.data.tags}
  dek={post.data.dek}
  section="writing"
  slug={post.data.slug}
  status={post.data.status}
  prev={link(prev)}
  next={link(next)}
>
  <PostScripts filePath={post.filePath} scripts={post.data.scripts} />
  <Content />
</Article>
